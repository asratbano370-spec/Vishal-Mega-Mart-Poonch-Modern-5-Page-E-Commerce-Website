
<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vishal Mega Mart - Poonch Store</title>
    <style>
        :root {
            --primary: #FF0055;
            --secondary: #7A00FF;
            --accent: #00E5FF;
            --yellow: #FFD600;
            --dark: #121212;
            --light: #F4F6F9;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        body { background: var(--light); color: #333; }

        /* Colorful Header Nav */
        header {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            padding: 15px 5%;
            position: sticky;
            top: 0;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        .logo { color: white; font-size: 24px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }
        .logo span { color: var(--yellow); }
        
        nav ul { display: flex; list-style: none; gap: 15px; }
        nav ul li a {
            color: white;
            text-decoration: none;
            font-weight: 600;
            padding: 8px 16px;
            border-radius: 20px;
            transition: 0.3s;
        }
        nav ul li a:hover, nav ul li a.active {
            background: var(--yellow);
            color: var(--dark);
        }

        /* Hero / Offers Banner */
        .hero {
            background: linear-gradient(45deg, #7A00FF, #FF0055, #00E5FF);
            background-size: 300% 300%;
            animation: gradientBG 8s ease infinite;
            color: white;
            text-align: center;
            padding: 60px 20px;
        }
        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .hero h1 { font-size: 40px; margin-bottom: 10px; text-shadow: 2px 2px 4px rgba(0,0,0,0.3); }
        .hero p { font-size: 20px; font-weight: 600; color: var(--yellow); }

        /* Main Container */
        .container { max-width: 1100px; margin: 30px auto; padding: 0 20px; }
        
        /* Section Pages Styling */
        .page-section {
            background: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            border-top: 5px solid var(--primary);
        }
        .section-title {
            font-size: 26px;
            color: var(--secondary);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Grid Layouts */
        .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }

        /* Store Card Info */
        .info-card {
            background: #fff;
            padding: 20px;
            border-radius: 12px;
            border-left: 5px solid var(--accent);
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }
        .info-card h4 { color: var(--secondary); font-size: 18px; margin-bottom: 8px; }

        /* Colorful Category Badges */
        .badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 50px;
            color: white;
            font-size: 12px;
            font-weight: bold;
            margin-bottom: 10px;
        }
        .bg-red { background: #FF0055; }
        .bg-purple { background: #7A00FF; }
        .bg-blue { background: #00E5FF; color: #000; }
        .bg-green { background: #00E676; color: #000; }

        /* Buttons */
        .btn {
            display: inline-block;
            padding: 12px 25px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            text-decoration: none;
            font-weight: bold;
            border-radius: 25px;
            box-shadow: 0 4px 15px rgba(255, 0, 85, 0.4);
            transition: 0.3s;
            border: none;
            cursor: pointer;
        }
        .btn:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255, 0, 85, 0.6); }

        /* Footer */
        footer {
            background: var(--dark);
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 40px;
        }
    </style>
</head>
<body>

    <!-- Header / Navigation (5 Pages Tabs) -->
    <header>
        <div class="logo">Vishal <span>Mega Mart</span></div>
        <nav>
            <ul>
                <li><a href="#home" class="active">Home</a></li>
                <li><a href="#store-info">Store Details</a></li>
                <li><a href="#offers">50% OFF Offers</a></li>
                <li><a href="#categories">Categories</a></li>
                <li><a href="#contact">Contact Us</a></li>
            </ul>
        </nav>
    </header>

    <!-- Page 1: Hero Banner -->
    <div class="hero" id="home">
        <span class="badge bg-green">UP TO 50% OFF</span>
        <h1>LOWEST PRICES ON GROCERY & FASHION</h1>
        <p>Visit Poonch Store Today for Exclusive Mega Deals!</p>
    </div>

    <div class="container">

        <!-- Page 2: Store Information -->
        <section class="page-section" id="store-info">
            <h2 class="section-title">📍 Store Location & Timing (Poonch)</h2>
            <div class="grid-3">
                <div class="info-card">
                    <h4>Address</h4>
                    <p>Nakha Wali Road, Near District Court, Nai Basti, Poonch, Jammu and Kashmir 185101</p>
                </div>
                <div class="info-card" style="border-left-color: var(--primary);">
                    <h4>Contact Number</h4>
                    <p>📞 0901 8314 007</p>
                    <p style="color: #00E676; font-weight: bold; margin-top: 5px;">Status: Open Now</p>
                </div>
                <div class="info-card" style="border-left-color: var(--yellow);">
                    <h4>Opening Hours</h4>
                    <p>⏰ 09:00 AM to 10:00 PM</p>
                    <p>(Monday to Sunday)</p>
                </div>
            </div>
            <br>
            <a href="https://maps.google.com" target="_blank" class="btn">🚀 Get Directions</a>
        </section>

        <!-- Page 3: Offers Section -->
        <section class="page-section" id="offers" style="border-top-color: var(--accent);">
            <h2 class="section-title">🔥 Exclusive Mega Deals</h2>
            <div class="grid-3">
                <div style="background: #FFF3F6; padding: 20px; border-radius: 10px;">
                    <span class="badge bg-red">Grocery Deal</span>
                    <h3>First Crop Staple Foods</h3>
                    <p>Atta, Rice, Pulses & Oil at lowest wholesale prices.</p>
                </div>
                <div style="background: #F3F0FF; padding: 20px; border-radius: 10px;">
                    <span class="badge bg-purple">Fashion Sale</span>
                    <h3>Flat 50% OFF Apparel</h3>
                    <p>Men, Women & Kids Trendy Wear collection.</p>
                </div>
                <div style="background: #E6FAFF; padding: 20px; border-radius: 10px;">
                    <span class="badge bg-blue">Home Essentials</span>
                    <h3>Buy 1 Get 1 Free</h3>
                    <p>Kitchenware, Storage Boxes & Home Decor.</p>
                </div>
            </div>
        </section>

        <!-- Page 4: Shop Categories -->
        <section class="page-section" id="categories" style="border-top-color: var(--yellow);">
            <h2 class="section-title">🛍️ Explore Categories</h2>
            <div class="grid-3">
                <div class="info-card">
                    <h4>🌾 Groceries & Food</h4>
                    <p>Daily essentials, snacks, beverages & packaged foods.</p>
                </div>
                <div class="info-card">
                    <h4>👕 Apparel & Footwear</h4>
                    <p>Latest seasonal fashion clothes for the entire family.</p>
                </div>
                <div class="info-card">
                    <h4>🏠 Household Items</h4>
                    <p>Cleaning supplies, cookware, plastics & organizers.</p>
                </div>
            </div>
        </section>

        <!-- Page 5: Contact & QR Code Section -->
        <section class="page-section" id="contact" style="border-top-color: var(--secondary);">
            <h2 class="section-title">📱 Connect & Visit Us</h2>
            <div style="display: flex; flex-wrap: wrap; gap: 30px; align-items: center;">
                <div style="flex: 1; min-width: 250px;">
                    <h3>Add Store To Contacts</h3>
                    <p>Scan QR Code at store counter or call directly for home order assistance.</p>
                    <br>
                    <p><strong>Store Direct Line:</strong> 0901 8314 007</p>
                    <p><strong>Customer Care:</strong> support@megamart.com</p>
                </div>
                <div style="background: var(--light); padding: 20px; border-radius: 15px; text-align: center;">
                    <div style="width: 120px; height: 120px; background: #333; color: white; margin: 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 10px;">
                        [ QR CODE ]
                    </div>
                    <p style="margin-top: 10px; font-weight: bold;">Scan to Save Contact</p>
                </div>
            </div>
        </section>

    </div>

    <footer>
        <p>&copy; 2026 Vishal Mega Mart Poonch Branch. All Rights Reserved.</p>
    </footer>

</body>
</html>
